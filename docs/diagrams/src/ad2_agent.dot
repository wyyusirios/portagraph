digraph AD {
  graph [rankdir=TB, fontname="DejaVu Sans", fontsize=13, nodesep=0.35, ranksep=0.32, pad=0.3, splines=ortho, labelloc=t, forcelabels=true];
  node  [fontname="DejaVu Sans", fontsize=11, shape=box, style="rounded,filled", fillcolor="#eef3fb", color="#2f4ac0", penwidth=1.3, margin="0.14,0.06"];
  edge  [fontname="DejaVu Sans", fontsize=10, color="#333333", arrowhead=vee, arrowsize=0.8];

  label="AD-2. Агентный анализ и построение единого графа (UC-06, UC-07)\n\n"; fontsize=14;
  s [shape=circle, style=filled, fillcolor=black, label="", width=0.26, fixedsize=true, color=black];
  a1 [label="Получить проиндексированные\nрепозитории проекта"];
  a2 [label="Определить роль репозитория\nэвристикой по структуре файлов"];
  a3 [label="Передать агенту README, структуру,\nточки входа и API-спецификацию"];
  a4 [label="Агент определяет назначение, роль\nи модули с оценкой уверенности", fillcolor="#ffe8a3", color="#d9480f", penwidth=1.8];
  d1 [shape=diamond, style=filled, fillcolor="#ffffff", color="#333333", label="", width=0.36, height=0.36, fixedsize=true];
  a5 [label="Принять роль, предложенную агентом"];
  a6 [label="Принять роль, найденную эвристикой"];
  m1 [shape=diamond, style=filled, fillcolor="#ffffff", color="#333333", label="", width=0.36, height=0.36, fixedsize=true];
  a7 [label="Создать узлы: репозиторий, сервис,\nмодули"];
  a8 [label="Извлечь классы и функции (Tree-\nsitter) и создать узлы"];
  d2 [shape=diamond, style=filled, fillcolor="#ffffff", color="#333333", label="", width=0.36, height=0.36, fixedsize=true];
  a9 [label="Найти кандидатов в связи: HTTP-\nвызовы, топики очередей, общие\nартефакты"];
  d3 [shape=diamond, style=filled, fillcolor="#ffffff", color="#333333", label="", width=0.36, height=0.36, fixedsize=true];
  a10 [label="Агент проверяет кандидатов и\nоценивает уверенность связей", fillcolor="#ffe8a3", color="#d9480f", penwidth=1.8];
  d4 [shape=diamond, style=filled, fillcolor="#ffffff", color="#333333", label="", width=0.36, height=0.36, fixedsize=true];
  a11 [label="Создать ребро графа с\nдоказательствами (файл, строка)"];
  a12 [label="Отбросить связь"];
  m2 [shape=diamond, style=filled, fillcolor="#ffffff", color="#333333", label="", width=0.36, height=0.36, fixedsize=true];
  d5 [shape=diamond, style=filled, fillcolor="#ffffff", color="#333333", label="", width=0.36, height=0.36, fixedsize=true];
  m3 [shape=diamond, style=filled, fillcolor="#ffffff", color="#333333", label="", width=0.36, height=0.36, fixedsize=true];
  a13 [label="Пометить ранее сформированные\nдокументы устаревшими"];
  a14 [label="Сохранить статистику и завершить\nзадачу анализа"];
  e [shape=circle, peripheries=2, style=filled, fillcolor=black, color=black, label="", width=0.26, fixedsize=true];
  s -> a1 [];
  a1 -> a2 [];
  a2 -> a3 [];
  a3 -> a4 [];
  a4 -> d1 [];
  d1 -> a5 [xlabel=" [уверенность агента ≥ эвристики] "];
  d1 -> a6 [xlabel=" [иначе] "];
  a5 -> m1 [];
  a6 -> m1 [];
  m1 -> a7 [];
  a7 -> a8 [];
  a8 -> d2 [];
  d2 -> a2 [xlabel=" [есть ещё репозитории] ", constraint=false];
  d2 -> a9 [xlabel=" [все обработаны] "];
  a9 -> d3 [];
  d3 -> m3 [xlabel=" [кандидатов нет] "];
  d3 -> a10 [xlabel=" [кандидаты найдены] "];
  a10 -> d4 [];
  d4 -> a11 [xlabel=" [уверенность ≥ 0,35] "];
  d4 -> a12 [xlabel=" [уверенность < 0,35] "];
  a11 -> m2 [];
  a12 -> m2 [];
  m2 -> d5 [];
  d5 -> d4 [xlabel=" [есть ещё вердикты] ", constraint=false];
  d5 -> m3 [xlabel=" [все вердикты учтены] "];
  m3 -> a13 [];
  a13 -> a14 [];
  a14 -> e [];
}
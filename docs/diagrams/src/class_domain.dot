digraph G {
  graph [fontname="DejaVu Sans", fontsize=14, pad=0.3, nodesep=0.45, ranksep=0.7, splines=true, labelloc=t , label="Диаграмма классов: доменная модель (пакет ru.portagraph.domain)\n\n", ranksep=0.9];
  node [shape=plain, fontname="DejaVu Sans", fontsize=10];
  edge [fontname="DejaVu Sans", fontsize=9, color="#333333", arrowsize=0.9];
  User [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" COLOR="#2f4ac0"><TR><TD BGCOLOR="#eef3fb" CELLPADDING="5"><B>User</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">- id: Long<BR ALIGN="LEFT"/>- email: String<BR ALIGN="LEFT"/>- passwordHash: String<BR ALIGN="LEFT"/>- fullName: String<BR ALIGN="LEFT"/>- createdAt: Instant<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"> </TD></TR></TABLE>>];
  Project [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" COLOR="#2f4ac0"><TR><TD BGCOLOR="#eef3fb" CELLPADDING="5"><B>Project</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">- id: Long<BR ALIGN="LEFT"/>- name: String<BR ALIGN="LEFT"/>- description: String<BR ALIGN="LEFT"/>- status: ProjectStatus<BR ALIGN="LEFT"/>- createdAt: Instant<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+ addRepository(r: GitRepository): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  ProjectMember [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" COLOR="#2f4ac0"><TR><TD BGCOLOR="#eef3fb" CELLPADDING="5"><B>ProjectMember</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">- id: Long<BR ALIGN="LEFT"/>- role: ProjectRole<BR ALIGN="LEFT"/>- joinedAt: Instant<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+ canApprove(): boolean<BR ALIGN="LEFT"/>+ canManage(): boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  RepoCredential [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" COLOR="#2f4ac0"><TR><TD BGCOLOR="#eef3fb" CELLPADDING="5"><B>RepoCredential</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">- id: Long<BR ALIGN="LEFT"/>- provider: GitProvider<BR ALIGN="LEFT"/>- encryptedToken: byte[]<BR ALIGN="LEFT"/>- scopes: String<BR ALIGN="LEFT"/>- expiresAt: Instant<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+ isExpired(now: Instant): boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  GitRepository [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" COLOR="#2f4ac0"><TR><TD BGCOLOR="#eef3fb" CELLPADDING="5"><B>GitRepository</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">- id: Long<BR ALIGN="LEFT"/>- provider: GitProvider<BR ALIGN="LEFT"/>- url: String<BR ALIGN="LEFT"/>- name: String<BR ALIGN="LEFT"/>- defaultBranch: String<BR ALIGN="LEFT"/>- detectedRole: RepositoryRole<BR ALIGN="LEFT"/>- roleConfidence: double<BR ALIGN="LEFT"/>- purposeSummary: String<BR ALIGN="LEFT"/>- status: RepositoryStatus<BR ALIGN="LEFT"/>- lastCommitSha: String<BR ALIGN="LEFT"/>- lastSyncedAt: Instant<BR ALIGN="LEFT"/>- webhookSecret: String<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+ markSynced(commitSha: String): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  AnalysisRun [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" COLOR="#2f4ac0"><TR><TD BGCOLOR="#eef3fb" CELLPADDING="5"><B>AnalysisRun</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">- id: Long<BR ALIGN="LEFT"/>- trigger: RunTrigger<BR ALIGN="LEFT"/>- status: RunStatus<BR ALIGN="LEFT"/>- progress: int<BR ALIGN="LEFT"/>- startedAt: Instant<BR ALIGN="LEFT"/>- finishedAt: Instant<BR ALIGN="LEFT"/>- errorMessage: String<BR ALIGN="LEFT"/>- artifactKey: String<BR ALIGN="LEFT"/>- stats: Map&lt;String, Object&gt;<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+ moveTo(next: RunStatus): void<BR ALIGN="LEFT"/>+ fail(message: String): void<BR ALIGN="LEFT"/>+ isActive(): boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  SourceFile [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" COLOR="#2f4ac0"><TR><TD BGCOLOR="#eef3fb" CELLPADDING="5"><B>SourceFile</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">- id: Long<BR ALIGN="LEFT"/>- path: String<BR ALIGN="LEFT"/>- language: String<BR ALIGN="LEFT"/>- kind: FileKind<BR ALIGN="LEFT"/>- contentSha: String<BR ALIGN="LEFT"/>- sizeBytes: long<BR ALIGN="LEFT"/>- storageKey: String<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"> </TD></TR></TABLE>>];
  CodeChunk [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" COLOR="#2f4ac0"><TR><TD BGCOLOR="#eef3fb" CELLPADDING="5"><B>CodeChunk</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">- id: Long<BR ALIGN="LEFT"/>- startLine: int<BR ALIGN="LEFT"/>- endLine: int<BR ALIGN="LEFT"/>- symbol: String<BR ALIGN="LEFT"/>- content: String<BR ALIGN="LEFT"/>- embedding: float[1536]<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"> </TD></TR></TABLE>>];
  GraphNode [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" COLOR="#2f4ac0"><TR><TD BGCOLOR="#eef3fb" CELLPADDING="5"><B>GraphNode</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">- id: Long<BR ALIGN="LEFT"/>- type: NodeType<BR ALIGN="LEFT"/>- name: String<BR ALIGN="LEFT"/>- qualifiedName: String<BR ALIGN="LEFT"/>- description: String<BR ALIGN="LEFT"/>- confidence: double<BR ALIGN="LEFT"/>- verified: boolean<BR ALIGN="LEFT"/>- metadata: Map&lt;String, Object&gt;<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"> </TD></TR></TABLE>>];
  GraphEdge [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" COLOR="#2f4ac0"><TR><TD BGCOLOR="#eef3fb" CELLPADDING="5"><B>GraphEdge</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">- id: Long<BR ALIGN="LEFT"/>- type: EdgeType<BR ALIGN="LEFT"/>- confidence: double<BR ALIGN="LEFT"/>- verified: boolean<BR ALIGN="LEFT"/>- evidence: List&lt;Map&lt;String, Object&gt;&gt;<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"> </TD></TR></TABLE>>];
  ChatSession [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" COLOR="#2f4ac0"><TR><TD BGCOLOR="#eef3fb" CELLPADDING="5"><B>ChatSession</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">- id: Long<BR ALIGN="LEFT"/>- title: String<BR ALIGN="LEFT"/>- createdAt: Instant<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+ addMessage(role: MessageRole, content: String): ChatMessage<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  ChatMessage [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" COLOR="#2f4ac0"><TR><TD BGCOLOR="#eef3fb" CELLPADDING="5"><B>ChatMessage</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">- id: Long<BR ALIGN="LEFT"/>- role: MessageRole<BR ALIGN="LEFT"/>- content: String<BR ALIGN="LEFT"/>- createdAt: Instant<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+ addCitation(file: SourceFile, start: int, end: int, node: GraphNode): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Citation [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" COLOR="#2f4ac0"><TR><TD BGCOLOR="#eef3fb" CELLPADDING="5"><B>Citation</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">- id: Long<BR ALIGN="LEFT"/>- startLine: int<BR ALIGN="LEFT"/>- endLine: int<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"> </TD></TR></TABLE>>];
  ImpactReport [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" COLOR="#2f4ac0"><TR><TD BGCOLOR="#eef3fb" CELLPADDING="5"><B>ImpactReport</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">- id: Long<BR ALIGN="LEFT"/>- changeDescription: String<BR ALIGN="LEFT"/>- changedNodeIds: List&lt;Long&gt;<BR ALIGN="LEFT"/>- maxDepth: int<BR ALIGN="LEFT"/>- affected: List&lt;Map&lt;String, Object&gt;&gt;<BR ALIGN="LEFT"/>- riskLevel: RiskLevel<BR ALIGN="LEFT"/>- recommendation: String<BR ALIGN="LEFT"/>- createdAt: Instant<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"> </TD></TR></TABLE>>];
  GeneratedDocument [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" COLOR="#2f4ac0"><TR><TD BGCOLOR="#eef3fb" CELLPADDING="5"><B>GeneratedDocument</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">- id: Long<BR ALIGN="LEFT"/>- type: DocumentType<BR ALIGN="LEFT"/>- title: String<BR ALIGN="LEFT"/>- contentMd: String<BR ALIGN="LEFT"/>- status: DocumentStatus<BR ALIGN="LEFT"/>- approvedAt: Instant<BR ALIGN="LEFT"/>- createdAt: Instant<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+ approve(architect: User): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  WebhookEvent [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" COLOR="#2f4ac0"><TR><TD BGCOLOR="#eef3fb" CELLPADDING="5"><B>WebhookEvent</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">- id: Long<BR ALIGN="LEFT"/>- deliveryId: String<BR ALIGN="LEFT"/>- eventType: String<BR ALIGN="LEFT"/>- branch: String<BR ALIGN="LEFT"/>- commitSha: String<BR ALIGN="LEFT"/>- receivedAt: Instant<BR ALIGN="LEFT"/>- processed: boolean<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"> </TD></TR></TABLE>>];
  RunStatus [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" COLOR="#495057"><TR><TD BGCOLOR="#f1f3f5" CELLPADDING="5"><FONT POINT-SIZE="9">«enumeration»</FONT><BR/><B>RunStatus</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">QUEUED<BR ALIGN="LEFT"/>FETCHING<BR ALIGN="LEFT"/>INDEXING<BR ALIGN="LEFT"/>ANALYZING<BR ALIGN="LEFT"/>BUILDING_GRAPH<BR ALIGN="LEFT"/>COMPLETED<BR ALIGN="LEFT"/>FAILED<BR ALIGN="LEFT"/>CANCELLED<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  NodeType [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" COLOR="#495057"><TR><TD BGCOLOR="#f1f3f5" CELLPADDING="5"><FONT POINT-SIZE="9">«enumeration»</FONT><BR/><B>NodeType</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">SYSTEM<BR ALIGN="LEFT"/>REPOSITORY<BR ALIGN="LEFT"/>SERVICE<BR ALIGN="LEFT"/>MODULE<BR ALIGN="LEFT"/>CLASS<BR ALIGN="LEFT"/>FUNCTION<BR ALIGN="LEFT"/>ENTITY<BR ALIGN="LEFT"/>API_ENDPOINT<BR ALIGN="LEFT"/>DATABASE<BR ALIGN="LEFT"/>MESSAGE_QUEUE<BR ALIGN="LEFT"/>EXTERNAL_SYSTEM<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  EdgeType [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" COLOR="#495057"><TR><TD BGCOLOR="#f1f3f5" CELLPADDING="5"><FONT POINT-SIZE="9">«enumeration»</FONT><BR/><B>EdgeType</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">CONTAINS<BR ALIGN="LEFT"/>DEPENDS_ON<BR ALIGN="LEFT"/>IMPORTS<BR ALIGN="LEFT"/>CALLS_HTTP<BR ALIGN="LEFT"/>PUBLISHES<BR ALIGN="LEFT"/>CONSUMES<BR ALIGN="LEFT"/>READS_WRITES<BR ALIGN="LEFT"/>IMPLEMENTS<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  ProjectRole [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" COLOR="#495057"><TR><TD BGCOLOR="#f1f3f5" CELLPADDING="5"><FONT POINT-SIZE="9">«enumeration»</FONT><BR/><B>ProjectRole</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">OWNER<BR ALIGN="LEFT"/>ARCHITECT<BR ALIGN="LEFT"/>DEVELOPER<BR ALIGN="LEFT"/>VIEWER<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  RepositoryRole [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" COLOR="#495057"><TR><TD BGCOLOR="#f1f3f5" CELLPADDING="5"><FONT POINT-SIZE="9">«enumeration»</FONT><BR/><B>RepositoryRole</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">SERVICE<BR ALIGN="LEFT"/>FRONTEND<BR ALIGN="LEFT"/>LIBRARY<BR ALIGN="LEFT"/>INFRASTRUCTURE<BR ALIGN="LEFT"/>DOCUMENTATION<BR ALIGN="LEFT"/>UNKNOWN<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  RiskLevel [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" COLOR="#495057"><TR><TD BGCOLOR="#f1f3f5" CELLPADDING="5"><FONT POINT-SIZE="9">«enumeration»</FONT><BR/><B>RiskLevel</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">LOW<BR ALIGN="LEFT"/>MEDIUM<BR ALIGN="LEFT"/>HIGH<BR ALIGN="LEFT"/>CRITICAL<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  DocumentStatus [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" COLOR="#495057"><TR><TD BGCOLOR="#f1f3f5" CELLPADDING="5"><FONT POINT-SIZE="9">«enumeration»</FONT><BR/><B>DocumentStatus</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">DRAFT<BR ALIGN="LEFT"/>APPROVED<BR ALIGN="LEFT"/>OUTDATED<BR ALIGN="LEFT"/></TD></TR></TABLE>>];

digraph DOC {
  graph [fontname="DejaVu Sans", fontsize=14, pad=0.3, labelloc=t, splines=true, nodesep=0.5, ranksep=0.55];
  node  [fontname="DejaVu Sans", fontsize=11, shape=box, style="rounded,filled", fillcolor="#eef3fb", color="#2f4ac0", penwidth=1.3, margin="0.18,0.08"];
  edge  [fontname="DejaVu Sans", fontsize=9, color="#333333", arrowhead=vee, arrowsize=0.8];
  init  [shape=circle, style=filled, fillcolor=black, color=black, label="", width=0.25, fixedsize=true];
  fin [shape=circle, peripheries=2, style=filled, fillcolor=black, color=black, label="", width=0.25, fixedsize=true];

  label="Диаграмма состояний объекта GeneratedDocument\n\n"; rankdir=LR;
  DRAFT    [label="DRAFT\nЧерновик AI"];
  APPROVED [label="APPROVED\nУтверждён\n—\nentry / approvedBy, approvedAt", fillcolor="#d3f9d8", color="#2b8a3e"];
  OUTDATED [label="OUTDATED\nУстарел", fillcolor="#f1f3f5", color="#495057"];
  init -> DRAFT [label=" generate() / агент\n сформировал Markdown "];
  DRAFT -> APPROVED [label=" approve() [роль OWNER\n или ARCHITECT] "];
  DRAFT -> OUTDATED [label=" завершён новый анализ "];
  APPROVED -> OUTDATED [label=" завершён новый анализ "];
  OUTDATED -> fin [label=" сформирован\n новый документ "];
}

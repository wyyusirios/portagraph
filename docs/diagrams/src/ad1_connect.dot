digraph AD {
  graph [rankdir=TB, fontname="DejaVu Sans", fontsize=13, nodesep=0.35, ranksep=0.32, pad=0.3, splines=ortho, labelloc=t, forcelabels=true];
  node  [fontname="DejaVu Sans", fontsize=11, shape=box, style="rounded,filled", fillcolor="#eef3fb", color="#2f4ac0", penwidth=1.3, margin="0.14,0.06"];
  edge  [fontname="DejaVu Sans", fontsize=10, color="#333333", arrowhead=vee, arrowsize=0.8];

  label="AD-1. Подключение репозиториев и первичный анализ (UC-02, UC-03, UC-04)\n\n"; fontsize=14;
  s [shape=circle, style=filled, fillcolor=black, label="", width=0.26, fixedsize=true, color=black];
  a1 [label="Создать проект: ввести название и\nописание"];
  a2 [label="Ввести адреса репозиториев и токен\nдоступа"];
  a3 [label="Определить Git-хостинг по адресу\nрепозитория"];
  a4 [label="Проверить доступ к репозиторию\nчерез API хостинга"];
  d1 [shape=diamond, style=filled, fillcolor="#ffffff", color="#333333", label="", width=0.36, height=0.36, fixedsize=true];
  a5 [label="Отметить репозиторий: «нет\nдоступа»"];
  a6 [label="Зашифровать токен (AES-256-GCM) и\nсохранить репозиторий"];
  a7 [label="Зарегистрировать webhook на push-\nсобытия"];
  m1 [shape=diamond, style=filled, fillcolor="#ffffff", color="#333333", label="", width=0.36, height=0.36, fixedsize=true];
  d2 [shape=diamond, style=filled, fillcolor="#ffffff", color="#333333", label="", width=0.36, height=0.36, fixedsize=true];
  d3 [shape=diamond, style=filled, fillcolor="#ffffff", color="#333333", label="", width=0.36, height=0.36, fixedsize=true];
  a8 [label="Показать результат по каждому\nадресу и предложить исправить\nошибки"];
  a9 [label="Поставить задачу анализа в очередь"];
  f1 [shape=box, style=filled, fillcolor=black, color=black, label="", width=2.8, height=0.06, fixedsize=true];
  p1 [label="Показать экран прогресса анализа"];
  p2 [label="Получить последние коммиты\nосновных веток"];
  p3 [label="Проиндексировать код и\nдокументацию (UC-05)"];
  p4 [label="Выполнить агентный анализ\nархитектуры (UC-06)", fillcolor="#ffe8a3", color="#d9480f", penwidth=1.8];
  p5 [label="Построить единый граф (UC-07)", fillcolor="#ffe8a3", color="#d9480f", penwidth=1.8];
  j1 [shape=box, style=filled, fillcolor=black, color=black, label="", width=2.8, height=0.06, fixedsize=true];
  d4 [shape=diamond, style=filled, fillcolor="#ffffff", color="#333333", label="", width=0.36, height=0.36, fixedsize=true];
  a10 [label="Показать ошибку и кнопку\n«Повторить анализ»"];
  a11 [label="Открыть карту системы"];
  e [shape=circle, peripheries=2, style=filled, fillcolor=black, color=black, label="", width=0.26, fixedsize=true];
  s -> a1 [];
  a1 -> a2 [];
  a2 -> a3 [];
  a3 -> a4 [];
  a4 -> d1 [];
  d1 -> a5 [xlabel=" [нет доступа] "];
  d1 -> a6 [xlabel=" [доступ есть] "];
  a6 -> a7 [];
  a5 -> m1 [];
  a7 -> m1 [];
  m1 -> d2 [];
  d2 -> a3 [xlabel=" [есть ещё адреса] ", constraint=false];
  d2 -> d3 [xlabel=" [все адреса обработаны] "];
  d3 -> a8 [xlabel=" [ни один не подключён] "];
  a8 -> a2 [constraint=false];
  d3 -> a9 [xlabel=" [подключён хотя бы один] "];
  a9 -> f1 [];
  f1 -> p1 [];
  f1 -> p2 [];
  p2 -> p3 [];
  p3 -> p4 [];
  p4 -> p5 [];
  p1 -> j1 [];
  p5 -> j1 [];
  j1 -> d4 [];
  d4 -> a10 [xlabel=" [ошибка] "];
  d4 -> a11 [xlabel=" [анализ завершён] "];
  a10 -> e [];
  a11 -> e [];
}
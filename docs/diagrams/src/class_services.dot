  RepositoryController [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" COLOR="#5f3dc4"><TR><TD BGCOLOR="#f3f0ff" CELLPADDING="5"><FONT POINT-SIZE="9">«RestController»</FONT><BR/><B>RepositoryController</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+ list(jwt, projectId): List&lt;RepositoryView&gt;<BR ALIGN="LEFT"/>+ connect(jwt, projectId, req): List&lt;ConnectResult&gt;<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  GraphController [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" COLOR="#5f3dc4"><TR><TD BGCOLOR="#f3f0ff" CELLPADDING="5"><FONT POINT-SIZE="9">«RestController»</FONT><BR/><B>GraphController</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+ graph(jwt, projectId, mode): GraphView<BR ALIGN="LEFT"/>+ verify(jwt, projectId, nodeId, req): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  AssistantController [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" COLOR="#5f3dc4"><TR><TD BGCOLOR="#f3f0ff" CELLPADDING="5"><FONT POINT-SIZE="9">«RestController»</FONT><BR/><B>AssistantController</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+ ask(jwt, projectId, req): AnswerView<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  ImpactController [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" COLOR="#5f3dc4"><TR><TD BGCOLOR="#f3f0ff" CELLPADDING="5"><FONT POINT-SIZE="9">«RestController»</FONT><BR/><B>ImpactController</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+ analyze(jwt, projectId, req): ImpactView<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  WebhookController [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" COLOR="#5f3dc4"><TR><TD BGCOLOR="#f3f0ff" CELLPADDING="5"><FONT POINT-SIZE="9">«RestController»</FONT><BR/><B>WebhookController</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+ github(repoId, body, headers): ResponseEntity<BR ALIGN="LEFT"/>+ bitbucket(repoId, body, headers): ResponseEntity<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  RepositoryConnectionService [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" COLOR="#1971c2"><TR><TD BGCOLOR="#e7f5ff" CELLPADDING="5"><FONT POINT-SIZE="9">«Service»</FONT><BR/><B>RepositoryConnectionService</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">- publicUrl: String<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+ connect(projectId, userId, urls, token): List&lt;ConnectResult&gt;<BR ALIGN="LEFT"/>+ list(projectId, userId): List&lt;GitRepository&gt;<BR ALIGN="LEFT"/>+ disconnect(projectId, userId, repoId): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  AnalysisPipeline [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" COLOR="#1971c2"><TR><TD BGCOLOR="#e7f5ff" CELLPADDING="5"><FONT POINT-SIZE="9">«Service»</FONT><BR/><B>AnalysisPipeline</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+ enqueue(projectId, trigger): AnalysisRun<BR ALIGN="LEFT"/>+ enqueue(projectId, trigger, onlyPaths): AnalysisRun<BR ALIGN="LEFT"/>+ execute(event: RunQueued): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  IndexingService [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" COLOR="#1971c2"><TR><TD BGCOLOR="#e7f5ff" CELLPADDING="5"><FONT POINT-SIZE="9">«Service»</FONT><BR/><B>IndexingService</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">~ MAX_FILE_BYTES: long = 524288<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+ indexRepository(repo, commitSha, onlyPaths): IndexStats<BR ALIGN="LEFT"/>~ classify(path): Optional&lt;FileKind&gt;<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  GraphService [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" COLOR="#1971c2"><TR><TD BGCOLOR="#e7f5ff" CELLPADDING="5"><FONT POINT-SIZE="9">«Service»</FONT><BR/><B>GraphService</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">~ MIN_EDGE_CONFIDENCE: double = 0.35<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+ analyzeRepositories(run): Map&lt;Long, GraphNode&gt;<BR ALIGN="LEFT"/>+ linkRepositories(run, components): int<BR ALIGN="LEFT"/>+ loadGraph(projectId): ArchitectureGraph<BR ALIGN="LEFT"/>+ overview(projectId, userId): ArchitectureGraph<BR ALIGN="LEFT"/>+ detailed(projectId, userId): ArchitectureGraph<BR ALIGN="LEFT"/>+ verifyNode(projectId, userId, nodeId, text): GraphNode<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  QuestionAnsweringService [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" COLOR="#1971c2"><TR><TD BGCOLOR="#e7f5ff" CELLPADDING="5"><FONT POINT-SIZE="9">«Service»</FONT><BR/><B>QuestionAnsweringService</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">~ TOP_K: int = 12<BR ALIGN="LEFT"/>~ MIN_CONFIDENCE: double = 0.4<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+ ask(projectId, userId, sessionId, question): ChatMessage<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  ImpactAnalysisService [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" COLOR="#1971c2"><TR><TD BGCOLOR="#e7f5ff" CELLPADDING="5"><FONT POINT-SIZE="9">«Service»</FONT><BR/><B>ImpactAnalysisService</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">~ DEFAULT_DEPTH: int = 3<BR ALIGN="LEFT"/>~ MAX_DEPTH: int = 6<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+ analyze(projectId, userId, description, nodeIds, depth): ImpactReport<BR ALIGN="LEFT"/>+ history(projectId, userId): List&lt;ImpactReport&gt;<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  DocumentationService [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" COLOR="#1971c2"><TR><TD BGCOLOR="#e7f5ff" CELLPADDING="5"><FONT POINT-SIZE="9">«Service»</FONT><BR/><B>DocumentationService</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+ generate(projectId, userId, type): GeneratedDocument<BR ALIGN="LEFT"/>+ approve(projectId, userId, docId): GeneratedDocument<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  WebhookService [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" COLOR="#1971c2"><TR><TD BGCOLOR="#e7f5ff" CELLPADDING="5"><FONT POINT-SIZE="9">«Service»</FONT><BR/><B>WebhookService</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+ handlePush(repoId, body, signature, push): Outcome<BR ALIGN="LEFT"/>~ signatureValid(secret, body, header): boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  AccessGuard [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" COLOR="#1971c2"><TR><TD BGCOLOR="#e7f5ff" CELLPADDING="5"><FONT POINT-SIZE="9">«Component»</FONT><BR/><B>AccessGuard</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+ requireMember(projectId, userId): ProjectMember<BR ALIGN="LEFT"/>+ requireApprover(projectId, userId): ProjectMember<BR ALIGN="LEFT"/>+ requireOwner(projectId, userId): ProjectMember<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  CredentialCipher [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" COLOR="#1971c2"><TR><TD BGCOLOR="#e7f5ff" CELLPADDING="5"><FONT POINT-SIZE="9">«Component»</FONT><BR/><B>CredentialCipher</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">- key: SecretKeySpec<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+ encrypt(token: String): byte[]<BR ALIGN="LEFT"/>+ decrypt(data: byte[]): String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  GitProviderClient [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" COLOR="#d9480f"><TR><TD BGCOLOR="#fff4e6" CELLPADDING="5"><FONT POINT-SIZE="9">«interface»</FONT><BR/><B><I>GitProviderClient</I></B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+ provider(): GitProvider<BR ALIGN="LEFT"/>+ verifyAccess(url, token): RepositoryInfo<BR ALIGN="LEFT"/>+ latestCommit(url, branch, token): String<BR ALIGN="LEFT"/>+ listFiles(url, sha, token): List&lt;RemoteFile&gt;<BR ALIGN="LEFT"/>+ readFile(url, sha, path, token): String<BR ALIGN="LEFT"/>+ changedFiles(url, from, to, token): List&lt;String&gt;<BR ALIGN="LEFT"/>+ registerWebhook(url, callback, secret, token): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  GitHubClient [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" COLOR="#d9480f"><TR><TD BGCOLOR="#fff4e6" CELLPADDING="5"><B>GitHubClient</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">- http: RestClient<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"> </TD></TR></TABLE>>];
  BitbucketClient [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" COLOR="#d9480f"><TR><TD BGCOLOR="#fff4e6" CELLPADDING="5"><B>BitbucketClient</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">- http: RestClient<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"> </TD></TR></TABLE>>];
  GitProviderRegistry [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" COLOR="#d9480f"><TR><TD BGCOLOR="#fff4e6" CELLPADDING="5"><B>GitProviderRegistry</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">- clients: Map&lt;GitProvider, GitProviderClient&gt;<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+ get(provider): GitProviderClient<BR ALIGN="LEFT"/>+ detect(url): GitProvider {static}<BR ALIGN="LEFT"/></TD></TR></TABLE>>];

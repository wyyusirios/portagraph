digraph G {
  graph [fontname="DejaVu Sans", fontsize=14, pad=0.3, nodesep=0.45, ranksep=0.7, splines=true, labelloc=t , label="Диаграмма классов: сервисный слой, интеграции и ядро алгоритмов\n\n", ranksep=0.8, nodesep=0.3];

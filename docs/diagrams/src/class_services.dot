  HermesAgentClient [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" COLOR="#d9480f"><TR><TD BGCOLOR="#fff4e6" CELLPADDING="5"><B>HermesAgentClient</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">- http: RestClient<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">- run(task, input, type): T<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  EmbeddingClient [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" COLOR="#d9480f"><TR><TD BGCOLOR="#fff4e6" CELLPADDING="5"><B>EmbeddingClient</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">- model: String<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+ embed(texts: List&lt;String&gt;): List&lt;float[]&gt;<BR ALIGN="LEFT"/>+ toPgVector(v: float[]): String {static}<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  ArchitectureGraph [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" COLOR="#2b8a3e"><TR><TD BGCOLOR="#ebfbee" CELLPADDING="5"><FONT POINT-SIZE="9">«core»</FONT><BR/><B>ArchitectureGraph</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">- nodes: Map&lt;Long, Node&gt;<BR ALIGN="LEFT"/>- outgoing: Map&lt;Long, List&lt;Edge&gt;&gt;<BR ALIGN="LEFT"/>- incoming: Map&lt;Long, List&lt;Edge&gt;&gt;<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+ addNode(n: Node): void<BR ALIGN="LEFT"/>+ addEdge(e: Edge): void<BR ALIGN="LEFT"/>+ dependenciesOf(id): List&lt;Edge&gt;<BR ALIGN="LEFT"/>+ dependentsOf(id): List&lt;Edge&gt;<BR ALIGN="LEFT"/>+ collapseTo(types: Set&lt;String&gt;): ArchitectureGraph<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  ImpactAnalyzer [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" COLOR="#2b8a3e"><TR><TD BGCOLOR="#ebfbee" CELLPADDING="5"><FONT POINT-SIZE="9">«core»</FONT><BR/><B>ImpactAnalyzer</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">- DECAY: double = 0.6 {readOnly}<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+ analyze(changed: Collection&lt;Long&gt;, maxDepth: int): ImpactResult<BR ALIGN="LEFT"/>~ assessRisk(affected): RiskLevel<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  SecretScanner [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" COLOR="#2b8a3e"><TR><TD BGCOLOR="#ebfbee" CELLPADDING="5"><FONT POINT-SIZE="9">«core»</FONT><BR/><B>SecretScanner</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+ scan(text: String): ScanResult<BR ALIGN="LEFT"/>+ isSecretFile(path: String): boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  CodeChunker [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" COLOR="#2b8a3e"><TR><TD BGCOLOR="#ebfbee" CELLPADDING="5"><FONT POINT-SIZE="9">«core»</FONT><BR/><B>CodeChunker</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">- windowLines: int<BR ALIGN="LEFT"/>- overlapLines: int<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+ chunk(content, symbols): List&lt;Chunk&gt;<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  DependencyExtractor [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" COLOR="#2b8a3e"><TR><TD BGCOLOR="#ebfbee" CELLPADDING="5"><FONT POINT-SIZE="9">«core»</FONT><BR/><B>DependencyExtractor</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">- knownServices: Set&lt;String&gt;<BR ALIGN="LEFT"/>- knownArtifacts: Set&lt;String&gt;<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+ extract(path, content): List&lt;LinkCandidate&gt;<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  RepositoryRoleClassifier [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" COLOR="#2b8a3e"><TR><TD BGCOLOR="#ebfbee" CELLPADDING="5"><FONT POINT-SIZE="9">«core»</FONT><BR/><B>RepositoryRoleClassifier</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+ classify(paths): Classification<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  SymbolExtractor [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" COLOR="#2b8a3e"><TR><TD BGCOLOR="#ebfbee" CELLPADDING="5"><FONT POINT-SIZE="9">«core»</FONT><BR/><B>SymbolExtractor</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+ extract(language, content): List&lt;SymbolSpan&gt;<BR ALIGN="LEFT"/></TD></TR></TABLE>>];

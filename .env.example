# Скопируйте в .env при необходимости. Без .env используются значения по умолчанию.
# Подключение к PostgreSQL (база создаётся автоматически при первом запуске)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/portagraph
# Порт веб-интерфейса
PORT=8000
# Адрес, по которому Git-хостинги будут слать веб-хуки
PUBLIC_URL=http://localhost:8000
# Демо-данные ShopFlow и демо-пользователи при первом запуске
DEMO_SEED=1
# Разрешить подключение локальных папок как репозиториев
ALLOW_LOCAL_PATHS=1
# Ограничение размера ZIP-архива, МБ
MAX_UPLOAD_MB=100
# Каталог для клонов и ключа шифрования (по умолчанию ./data)
# PORTAGRAPH_DATA_DIR=./data
# Часовой пояс отображения дат
PORTAGRAPH_TZ=Europe/Moscow
